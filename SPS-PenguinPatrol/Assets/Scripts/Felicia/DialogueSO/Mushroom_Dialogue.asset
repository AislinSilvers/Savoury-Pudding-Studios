  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: Mushroom_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: f39f1817ddb43434a98e0963c79e1969, type: 2}
    text: Hi! What are you doing down here?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: I came to see if my brother is here.
  - speaker: {fileID: 11400000, guid: f39f1817ddb43434a98e0963c79e1969, type: 2}
    text: Oh no, did you lose your brother?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Yes, and now I am on adventure to find him.
  - speaker: {fileID: 11400000, guid: f39f1817ddb43434a98e0963c79e1969, type: 2}
    text: Adventures are so cool. I hope you find your brother soon.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Thank you. Do you know how to get back up?
  - speaker: {fileID: 11400000, guid: f39f1817ddb43434a98e0963c79e1969, type: 2}
    text: Yes, just jump on mushrooms, they will boost you.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Okay, thank you so much.
  - speaker: {fileID: 11400000, guid: f39f1817ddb43434a98e0963c79e1969, type: 2}
    text: No worries! Good luck!
  options: []
