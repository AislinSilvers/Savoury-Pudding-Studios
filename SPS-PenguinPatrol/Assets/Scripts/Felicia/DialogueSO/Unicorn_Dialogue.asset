--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: Unicorn_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: Hello, penguin. What are you doing here?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hello. I lost my brother, he might be here. Who are you?
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: I am a unicorn, the national animal of Scotland.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Scotland? How can I get to Highlands?
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: You are in Highlands, on a Loch Ness Monster. But do not worry, Nessie
      is really kind.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Did you see any penguins?
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: No, but you can look in the castle.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: But how? It is so high!
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: You need to do a puzzle. Then, you can jump across.
  - speaker: {fileID: 11400000, guid: 76b75dc3d4ffcb147b5d2297e1551e00, type: 2}
    text: I need to go now. Goodbye and good luck!
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Goodbye!
  options: []
