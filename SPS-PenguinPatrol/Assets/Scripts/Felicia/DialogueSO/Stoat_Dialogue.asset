  lines:
  - speaker: {fileID: 11400000, guid: efc3036043680ac4d972c14512cff3ca, type: 2}
    text: Hi, are you okay?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hi. No, I lost my brother. Did you see him?
  - speaker: {fileID: 11400000, guid: efc3036043680ac4d972c14512cff3ca, type: 2}
    text: I did see a penguin. Just over to the other side and check!
