--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: Rat_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Booo! Did I scare you?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Um... No.
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Hey, do not lie! It is my job.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Okay. Now, can you help me with a puzzle?
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: No, you do not need it.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Um, sorry? Why do you think so?
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Because it is nothing!
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: I think this puzzle will open a tunnel.
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: No, it is a lie! Now go away.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: That was rude...
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Puzzle does not open anything. I tell the truth.
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Also, if you see a bear, do not listen to them. They are a liar. Now go
      away.
  - speaker: {fileID: 11400000, guid: 089d264f555c6174898fdf1a6579261b, type: 2}
    text: Okay, bye...
  options: []
