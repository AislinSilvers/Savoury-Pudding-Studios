  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: Owl_DIalogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: b629be72c155d7b43bc86ce4e8219888, type: 2}
    text: Hi, are you okay?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hello. I am lost. How go I get down?
  - speaker: {fileID: 11400000, guid: b629be72c155d7b43bc86ce4e8219888, type: 2}
    text: You need to slide in one of the tunnels.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: But what if I choose a wrong one?
  - speaker: {fileID: 11400000, guid: b629be72c155d7b43bc86ce4e8219888, type: 2}
    text: Then come back here and try again.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Okay, thank you!
  - speaker: {fileID: 11400000, guid: b629be72c155d7b43bc86ce4e8219888, type: 2}
    text: No problem!
