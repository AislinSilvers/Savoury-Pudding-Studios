  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: DeerDialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hi. I like your horns.
  - speaker: {fileID: 11400000, guid: 6c0c0cb90836f27489853aada4749a86, type: 2}
    text: Thank you. I like your colour.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Thank you! Do you know how can I get to the castle?
  - speaker: {fileID: 11400000, guid: 6c0c0cb90836f27489853aada4749a86, type: 2}
    text: Ah, you need to complete a puzzle to make a bridge.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: And how do I do that?
  - speaker: {fileID: 11400000, guid: 6c0c0cb90836f27489853aada4749a86, type: 2}
    text: Jump on tiles to insert the password. It is TRIANGLE, STAR, SQUARE, CIRCLE.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Thank you so much!
  - speaker: {fileID: 11400000, guid: 6c0c0cb90836f27489853aada4749a86, type: 2}
    text: You are welcome!
  options: []
