  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: MammothDialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hello!
  - speaker: {fileID: 11400000, guid: dd94bb2a4c168914b8e1441f43792523, type: 2}
    text: Huh? Oh, hello kid. Where did you come from?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: From a big island behind.
  - speaker: {fileID: 11400000, guid: dd94bb2a4c168914b8e1441f43792523, type: 2}
    text: No way! That was far, I am surprised you came all the way here.
  - speaker: {fileID: 11400000, guid: dd94bb2a4c168914b8e1441f43792523, type: 2}
    text: I do not remember the last time I saw anyone. I do not have friends to
      visit me.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: 'I am sorry to hear that. I also do not have friends. Maybe I can become
      your friend? '
  - speaker: {fileID: 11400000, guid: dd94bb2a4c168914b8e1441f43792523, type: 2}
    text: Thank you, kid, I will appreciate that. Come back soon!
  - speaker: {fileID: 11400000, guid: dd94bb2a4c168914b8e1441f43792523, type: 2}
    text: 'I will! '
  options: []
