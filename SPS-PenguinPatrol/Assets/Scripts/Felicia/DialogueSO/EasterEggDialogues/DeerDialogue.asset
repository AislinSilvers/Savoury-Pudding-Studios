--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: DeerDialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hi. I like your horns.
  - speaker: {fileID: 11400000, guid: be3f068c0ce8182458bba6c1a3ab84a2, type: 2}
    text: These are called antlers, Mister.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Oh, sorry, I did not know. But also, I am not a mister.
  - speaker: {fileID: 11400000, guid: be3f068c0ce8182458bba6c1a3ab84a2, type: 2}
    text: Okay, then how do I call you?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: You can call me just a penguin. But I am not mister or miss. I do not identify
      as those.
  - speaker: {fileID: 11400000, guid: be3f068c0ce8182458bba6c1a3ab84a2, type: 2}
    text: I am sorry for calling you Mister. I can call you a kid, since I am definitely
      older than you, or what would you prefer?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: You can call me your friend. I have only one friend, a Mammoth from my
      home town, but I hope to have more friends!
  - speaker: {fileID: 11400000, guid: be3f068c0ce8182458bba6c1a3ab84a2, type: 2}
    text: Alright, we can be friends. Will you come visit me again?
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Of course! That is what friends do. But I need to go now. I will see you
      soon.
  - speaker: {fileID: 11400000, guid: be3f068c0ce8182458bba6c1a3ab84a2, type: 2}
    text: See you, friend.
  options: []
