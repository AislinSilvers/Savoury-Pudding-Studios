  m_Script: {fileID: 11500000, guid: 417537591e290ed4cbe1c39452e3d179, type: 3}
  m_Name: OlmDialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Hi! I like your colour!
  - speaker: {fileID: 11400000, guid: 0bdd5293f2c59024380d1eb9b2e17acf, type: 2}
    text: Thank you, kid. I like your colour too. It is beautiful.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: Thank you! I used to think I am not beautiful because no one else had the
      same colour.
  - speaker: {fileID: 11400000, guid: 0bdd5293f2c59024380d1eb9b2e17acf, type: 2}
    text: I think you look special. Do not listen to bad words that others say.
  - speaker: {fileID: 11400000, guid: bae752d3182d29548bf4816039f958c1, type: 2}
    text: You are right, thank you. I need to go now, but I will see you again.
  - speaker: {fileID: 11400000, guid: 0bdd5293f2c59024380d1eb9b2e17acf, type: 2}
    text: See you!
  options: []
